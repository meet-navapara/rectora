rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.schemaVersion is int;
      allow delete: if request.auth != null && request.auth.uid == uid;

      match /gameProgress/{progressId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.schemaVersion is int
          && request.resource.data.payload is string
          && request.resource.data.payload.size() < 900000
          && request.resource.data.revision is int
          && request.resource.data.revision > 0;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
